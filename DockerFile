# Use an official lightweight Python image
FROM python:3.10-slim

# Install the underlying Linux OS dependencies required by WeasyPrint
RUN apt-get update && apt-get install -y \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libffi-dev \
    libjpeg-dev \
    libopenjp2-7-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory in the container
WORKDIR /app

# Copy your requirements and install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of your app's code
COPY . .

# Expose the port Render uses
EXPOSE 10000

# Start the Flask app using Gunicorn (replace "run:app" with your actual entry point)
# e.g., if your main file is run.py and the flask app variable is 'app', use run:app
CMD ["gunicorn", "run:app", "--bind", "0.0.0.0:10000"]